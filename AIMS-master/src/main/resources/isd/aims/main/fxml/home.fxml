<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="820.0" prefWidth="1326.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Header -->
      <HBox prefHeight="104.0" prefWidth="1326.0" style="-fx-background-color: #ccebff; -fx-border-color: #33adff;">
         <children>
            <!-- Logo -->
            <VBox prefHeight="102.0" prefWidth="231.0">
               <children>
                  <Pane prefHeight="102.0" prefWidth="237.0">
                     <children>
                        <ImageView fx:id="aimsImage" fitHeight="94.0" fitWidth="115.0" layoutY="1.0" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                           <image>
                              <Image url="@../fxml/images/Logo.png" />
                           </image>
                        </ImageView>
                        <Label layoutX="6.0" layoutY="68.0" prefHeight="41.0" prefWidth="100.0" text="    AIMS" textAlignment="CENTER" textFill="#5091e6">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                     </children>
                  </Pane>
               </children>
            </VBox>

            <!-- Search -->
            <HBox prefHeight="102.0" prefWidth="882.0">
               <children>
                  <!-- Search bar -->
                  <Pane prefHeight="102.0" prefWidth="562.0">
                     <children>
                        <TextField fx:id="textFieldSearchBar" layoutX="17.0" layoutY="27.0" prefHeight="48.0" prefWidth="528.0">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </TextField>
                     </children>
                  </Pane>

                  <!-- Search button -->
                  <Pane prefHeight="102.0" prefWidth="158.0">
                     <children>
                        <SplitMenuButton fx:id="splitMenuBtnSearch" layoutY="27.0" mnemonicParsing="false" prefHeight="48.0" prefWidth="124.0" text="Search">
                           <items>
                           </items>
                           <font>
                              <Font size="16.0" />
                           </font>
                        </SplitMenuButton>
                     </children>
                  </Pane>
               </children>
            </HBox>

            <!-- Cart -->
            <VBox prefHeight="102.0" prefWidth="161.0">
               <children>
                  <Pane prefHeight="200.0" prefWidth="200.0">
                     <children>
                        <ImageView fx:id="cartImage" fitHeight="75.0" fitWidth="64.0" layoutX="14.0" layoutY="19.0" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                           <image>
                              <Image url="@../fxml/images/cart.png" />
                           </image>
                        </ImageView>
                        <Label fx:id="numMediaInCart" layoutX="24.0" layoutY="11.0" prefHeight="16.0" prefWidth="64.0" text="0 media" textFill="#5091e6" />
                     </children>
                  </Pane>
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Sort -->
      <HBox layoutX="1233.0" layoutY="123.0">
         <children>
            <SplitMenuButton fx:id="splitMenuBtnSort" mnemonicParsing="false" text="Sort">
              <items>

              </items>
            </SplitMenuButton>
         </children>
      </HBox>

            <!-- Body -->
      <ScrollPane layoutX="13.0" layoutY="165.0" prefHeight="629.0" prefWidth="1300.0">
         <content>
            <VBox fx:id="vboxMedia" prefHeight="629.0" prefWidth="1283.0">
               <children>
                  <HBox prefHeight="629.0" prefWidth="321.0" style="-fx-border-color: #33adff;" />
                  <HBox prefHeight="629.0" prefWidth="321.0" style="-fx-border-color: #33adff;" />
                  <HBox prefHeight="629.0" prefWidth="321.0" style="-fx-border-color: #33adff;" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
      <HBox layoutX="1195.0" layoutY="794.0" prefHeight="25.0" prefWidth="100.0">
         <children>
            <Button fx:id="previousPageBtn" mnemonicParsing="false" text="previous" />
            <Button fx:id="nextPageBtn" mnemonicParsing="false" text="next" />
         </children>
      </HBox>
   </children>
