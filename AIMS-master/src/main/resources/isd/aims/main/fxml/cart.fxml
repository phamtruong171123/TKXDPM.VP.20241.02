<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
   prefHeight="768.0" prefWidth="1366.0" xmlns="http://javafx.com/javafx/11.0.1"
   xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Back to Home -->
      <ImageView fx:id="aimsImage" fitHeight="73.0" fitWidth="73.0" layoutX="-6.0" layoutY="8.0"
                 pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
         <image>
            <Image url="@images/Logo.png" />
         </image>
      </ImageView>

      <!-- TITLE: CART -->
      <Label fx:id="pageTitle" layoutX="60.0" layoutY="-9.0" prefHeight="96.0" prefWidth="128.0"
         text="CART" textAlignment="CENTER" textFill="#5091e6">
         <font>
            <Font name="Segoe UI Semibold" size="42.0" />
         </font>
      </Label>


      <ScrollPane hbarPolicy="NEVER" layoutX="14.0" layoutY="70.0" maxHeight="-Infinity"
         maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="678.0"
         prefWidth="987.0">
         <content>
            <VBox fx:id="vboxCart" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
               minWidth="-Infinity" prefWidth="567.0" />
         </content>
      </ScrollPane>

      <!-- Tính tiền -->
      <VBox layoutX="1012.0" layoutY="70.0" prefHeight="288.0" prefWidth="344.0">
         <children>
            <!-- Subtotal -->
            <HBox prefHeight="56.0" prefWidth="316.0">
               <children>
                  <Label fx:id="subtotal" maxHeight="-Infinity" maxWidth="-Infinity"
                     minHeight="-Infinity" minWidth="-Infinity" prefHeight="55.0" prefWidth="163.0"
                     text="Subtotal:" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label fx:id="labelSubtotal" prefHeight="55.0" prefWidth="239.0"
                     text="0 VND" textFill="#5091e6">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <!-- VAT -->
            <HBox prefHeight="83.0" prefWidth="344.0">
               <children>
                  <Label prefHeight="58.0" prefWidth="54.0" text="VAT">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label prefHeight="58.0" prefWidth="106.0" text="(10%):">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label fx:id="labelVAT" prefHeight="58.0" prefWidth="167.0" text="0 VND" textFill="#5091e6">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <!-- Amount -->
            <HBox prefHeight="70.0" prefWidth="344.0">
               <children>
                  <Label contentDisplay="CENTER" prefHeight="45.0" prefWidth="180.0" text="Amount:">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label fx:id="labelAmount" prefHeight="45.0" prefWidth="206.0" text="0 VND"
                     textFill="#5091e6">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <!-- Button Place order -->
            <AnchorPane prefHeight="138.0" prefWidth="344.0">
               <children>
                  <Button fx:id="btnPlaceOrder" alignment="CENTER" contentDisplay="CENTER"
                     layoutX="14.0" layoutY="75.0" mnemonicParsing="false" prefHeight="55.0" prefWidth="316.0"
                     style="-fx-background-color: #5091e6; -fx-cursor: hand;" text="Place order"
                     textFill="WHITE">
                     <font>
                        <Font name="Segoe UI Bold" size="24.0" />
                     </font>
                  </Button>
               </children>
            </AnchorPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
